# Bu dosyayi kopyalayip .env olarak kaydedin:  cp .env.example .env

# Uygulama
NODE_ENV=development
PORT=3000

# Davet linklerinin koku. Verilmezse http://localhost:$PORT kullanilir;
# uretimde gercek alan adini yazin, yoksa paylasilan link localhost'u gosterir.
APP_URL=http://localhost:3000

# Morgan log formati (dev | combined | tiny)
LOG_LEVEL=dev

# PostgreSQL baglanti adresi (knex hem uygulamada hem CLI'da bunu kullanir)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evenup

# Yonetilen PostgreSQL servisleri (Render, Heroku, Supabase...) icin true yapin
DATABASE_SSL=false

# JWT imzalama anahtari (uretimde guclu ve gizli bir deger kullanin)
# Ornek uretim: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_super_secret_key

# Access token omru: '7d', '12h', '30m' ya da saniye cinsinden sayi
JWT_EXPIRES_IN=7d

# bcrypt maliyet katsayisi (10-12 araligina sikistirilir)
BCRYPT_SALT_ROUNDS=12

# Anthropic API anahtari — dogal dil harcama ekleme (POST /groups/:id/messages)
# icin gerekli. Verilmezse uygulama calisir ama o uc 503 doner.
ANTHROPIC_API_KEY=

# Ayristirmada kullanilan model. Isim/katilimci eslestirme hata riski tasidigi
# icin varsayilan Sonnet; metin-only basit senaryolarda Haiku'ya dusurulebilir.
ANTHROPIC_MODEL=claude-sonnet-5
